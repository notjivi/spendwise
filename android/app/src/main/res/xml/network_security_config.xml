<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only, system CAs only. The debug source set overrides this to allow the emulator host. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
