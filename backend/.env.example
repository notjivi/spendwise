# Auth: either a path to the service-account file, or the same JSON base64-encoded (for Render/Railway)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-sa.json
FIREBASE_CREDENTIALS_B64=
# Gemini: get a key at aistudio.google.com/apikey. Pick a current Flash-tier model from the docs.
GEMINI_API_KEY=
GEMINI_MODEL=
# App
DATABASE_URL=sqlite:///./spendwise.db
# JSON list. Native apps don't need CORS; keep empty unless you add a web client.
CORS_ORIGINS=[]
AI_RATE_LIMIT_PER_MIN=20
AI_MAX_INPUT_CHARS=1000
